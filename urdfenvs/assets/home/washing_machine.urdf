<?xml version="1.0"?>
<robot name="washing_machine">
<link name="washing_machine_base_link">
  <inertial>
    <mass value="100.0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
  </inertial>

  <visual>
    <origin xyz="0 0 0" rpy="1.57 0 0"/>
    <geometry>
      <mesh filename="package://meshes/washing_machine.dae" scale="1 1 1"/>
    </geometry>
    <material name="material_name">
      <color rgba="0.5 0.5 0.5 1.0"/>
    </material>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="1.57 0 0"/>
    <geometry>
      <mesh filename="package://meshes/washing_machine.dae" scale="1 1 1"/> 
      
      </geometry>
  </collision>
</link>
</robot>
